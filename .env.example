# Recipient's phone number with country code (e.g., +1234567890)
TARGET_PHONE_NUMBER=+1234567890

# The message to send
MESSAGE_TEXT=This is a scheduled message.

# Mode: 'once' (scheduled date/time) or 'recurring' (repeating intervals)
SCHEDULE_MODE=once

# --- ONE-TIME MODE (YYYY-MM-DD HH:MM in 24-hr format) ---
SCHEDULE_DATETIME=2026-10-15 14:30

# --- RECURRING MODE ---
INTERVAL_HOURS=2
WINDOW_START_TIME=05:30
WINDOW_END_TIME=20:00